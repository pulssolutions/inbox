# Fallback brand strings for a local build. scripts/deploy.mjs writes the real
# values into .env.local from the deployment profile, and .env.local wins - so
# nothing company-specific belongs in this file.
VITE_APP_TITLE=Inbox
VITE_APP_DESCRIPTION=Shared support inbox.
VITE_BRAND_SHORT=Inbox
VITE_BRAND_TAGLINE=Inbox
VITE_BRAND_FULL=Inbox
